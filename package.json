{
  "name": "sistema-cortinas",
  "private": true,
  "workspaces": ["motor-calculo", "api", "web"],
  "scripts": {
    "postinstall": "npm run build -w motor-calculo",
    "dev:api": "npm run dev -w api",
    "dev:web": "npm run dev -w web",
    "db:migrar": "npm run db:migrar -w api",
    "db:exemplo": "npm run db:exemplo -w api",
    "admin:criar": "npm run admin:criar -w api",
    "precos-barra:importar": "npm run precos-barra:importar -w api",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm test -w motor-calculo && npm test -w api",
    "build": "npm run build --workspaces"
  },
  "engines": { "node": ">=22" }
}
