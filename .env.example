# Copie para .env na raiz e ajuste.
DATABASE_URL=postgres://cortinas:cortinas@localhost:5432/cortinas
# Banco só para os testes da API (é apagado e recriado a cada execução).
DATABASE_URL_TESTE=postgres://cortinas:cortinas@localhost:5432/cortinas_teste
API_PORTA=3333
# Endereço da API visto pelo Next.js (servidor).
API_URL=http://localhost:3333
# Dias até a sessão expirar (renova a cada uso).
SESSAO_DIAS=30
# Tentativas de login por minuto por IP.
LIMITE_LOGIN_POR_MINUTO=10

# ---------- Produção (Easypanel) ----------
# Preencha estas no painel do Easypanel (aba Environment do serviço), nunca no repositório.
# DATABASE_URL: copie a "Internal Connection URL" do serviço PostgreSQL do Easypanel.
# Primeiro administrador (criado só se ainda não existir nenhum ADMIN; troca de senha no 1º acesso).
ADMIN_EMAIL=
ADMIN_NOME=
# Mínimo de 8 caracteres, com letras e números. Pode apagar depois do primeiro acesso.
ADMIN_SENHA_INICIAL=
# Nome da loja (opcional).
LOJA_NOME=
# Backup diário: pasta (no container já vem /dados/backups), quantos manter e a hora local.
BACKUP_PASTA=
BACKUP_MANTER=14
BACKUP_HORA=3
