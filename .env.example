# Copie para .env na raiz e ajuste.
DATABASE_URL=postgres://cortinas:cortinas@localhost:5432/cortinas
# Banco só para os testes da API (é apagado e recriado a cada execução).
DATABASE_URL_TESTE=postgres://cortinas:cortinas@localhost:5432/cortinas_teste
API_PORTA=3333
# Endereço da API visto pelo Next.js (servidor).
API_URL=http://localhost:3333
# Dias até a sessão expirar (renova a cada uso).
SESSAO_DIAS=30
# Tentativas de login por minuto por IP.
LIMITE_LOGIN_POR_MINUTO=10
